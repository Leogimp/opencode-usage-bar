{
  "name": "@leo.gimp/opencode-usage-bar",
  "version": "0.1.0",
  "description": "OpenCode Go subscription usage bars for the opencode TUI - 5h/weekly/monthly windows, /usage popup",
  "type": "module",
  "main": "dist/tui.tsx",
  "exports": {
    "./tui": "./dist/tui.tsx"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "bin": {
    "opencode-usage-bar": "scripts/install.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install-plugin": "node scripts/install.mjs",
    "postinstall": "node scripts/install.mjs"
  },
  "dependencies": {
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.10"
  },
  "keywords": [
    "opencode",
    "opencode-go",
    "usage",
    "tui",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leogimp/opencode-usage-bar.git"
  },
  "bugs": {
    "url": "https://github.com/Leogimp/opencode-usage-bar/issues"
  },
  "homepage": "https://github.com/Leogimp/opencode-usage-bar#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
